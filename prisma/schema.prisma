datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISIT_SCHEDULED
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadSource {
  WEBSITE
  REFERRAL
  WALK_IN
  SOCIAL_MEDIA
  GOOGLE_ADS
  FACEBOOK_ADS
  OTHER
}

enum CommunicationType {
  CALL
  EMAIL
  WHATSAPP
  SMS
  MEETING
  OTHER
}

enum ActivityAction {
  LOGIN
  LOGOUT
  PROPERTY_VIEW
  PROPERTY_SAVE
  PROPERTY_UNSAVE
  PROPERTY_CREATE
  PROPERTY_UPDATE
  PROPERTY_DELETE
  PROPERTY_PUBLISH
  PROPERTY_ARCHIVE
  PROPERTY_RESTORE
  INQUIRY_CREATE
  INQUIRY_UPDATE
  INQUIRY_DELETE
  APPOINTMENT_CREATE
  APPOINTMENT_UPDATE
  APPOINTMENT_DELETE
  USER_SUSPEND
  USER_RESTORE
  ROLE_PROMOTE
  ROLE_REVOKE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  EMAIL_VERIFIED
  SYSTEM_EVENT
  PROFILE_UPDATE
  ROLE_HISTORY_CREATE
  STATUS_HISTORY_CREATE
  APPOINTMENT_RESCHEDULE
  APPOINTMENT_CANCEL
  APPOINTMENT_OUTCOME
  APPOINTMENT_REMINDER
  
  // CRM Actions
  LEAD_CREATE
  LEAD_UPDATE
  LEAD_ASSIGN
  LEAD_REASSIGN
  LEAD_STATUS_CHANGE
  FOLLOW_UP_CREATE
  FOLLOW_UP_COMPLETE
  FOLLOW_UP_OVERDUE
  COMMUNICATION_LOG
  MAP_CURRENT_LOCATION_USED

  // Super Admin & Governance Actions
  ADMIN_CREATED
  ADMIN_PROMOTED
  ADMIN_REVOKED
  ADMIN_SUSPENDED
  ADMIN_RESTORED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  SESSION_CREATED
  SESSION_TERMINATED
  SECURITY_ALERT
  ADMIN_REVIEW
  EXPORT_DATA

  // Wave 7 Actions
  FOUNDER_ACCESS
  FOUNDER_PROMOTION
  FOUNDER_DEMOTION
  SUPER_ADMIN_CREATED
  SUPER_ADMIN_REMOVED
  GOVERNANCE_OVERRIDE
  IMMORTAL_ACCESS
  IMMORTAL_LOCKDOWN
  IMMORTAL_OVERRIDE
  PROTECTED_ACCOUNT_ACCESS_ATTEMPT
  OWNERSHIP_TRANSFER
}

enum NotificationType {
  INQUIRY
  APPOINTMENT
  PROPERTY
  SECURITY
  USER_ACTION
  SYSTEM
  
  // CRM Notifications
  FOLLOW_UP_DUE
  FOLLOW_UP_OVERDUE
  FOLLOW_UP_COMPLETED
}

model User {
  id                String          @id @default(uuid())
  name              String?
  email             String          @unique
  phone             String?
  password          String?
  role              UserRole        @default(USER)
  emailVerified     DateTime?
  status            UserStatus      @default(ACTIVE)
  lastLogin         DateTime?
  lastActivity      DateTime?
  deletedAt         DateTime?       // Prepared for soft delete
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  appointments      Appointment[]
  savedProperties   SavedProperty[]
  authTokens        AuthToken[]
  
  // Relations for Actor/Target Activity Logging
  actedActivities   ActivityLog[]   @relation("ActorRelation")
  targetActivities  ActivityLog[]   @relation("TargetRelation")
  
  notifications     Notification[]
  propertyViews     PropertyView[]
  priceHistoryChanges PropertyPriceHistory[] @relation("PriceChangedBy")

  // Lead CRM relations
  leadsAssigned        Lead[]                  @relation("LeadAssignedAdmin")
  notesCreated         LeadNote[]              @relation("NoteCreatedBy")
  commentsCreated      LeadComment[]           @relation("CommentCreatedBy")
  assignmentsTarget    LeadAssignmentHistory[] @relation("AssignmentHistoryTarget")
  assignmentsActor     LeadAssignmentHistory[] @relation("AssignmentHistoryActor")
  statusHistories      LeadStatusHistory[]     @relation("StatusHistoryActor")
  followUpsAssigned    FollowUp[]              @relation("FollowUpAssignedAdmin")
  followUpsCreated     FollowUp[]              @relation("FollowUpCreatedBy")
  communicationsCreated CommunicationLog[]     @relation("CommunicationCreatedBy")

  // Relations for User History logging
  roleHistoryTargets    RoleHistory[]         @relation("RoleHistoryTarget")
  roleHistoryActors     RoleHistory[]         @relation("RoleHistoryActor")
  statusHistoryTargets  UserStatusHistory[]   @relation("StatusHistoryTarget")
  statusHistoryActors   UserStatusHistory[]   @relation("StatusHistoryActor")
  profileHistoryTargets UserProfileHistory[]  @relation("ProfileHistoryTarget")
  profileHistoryActors  UserProfileHistory[]  @relation("ProfileHistoryActor")

  // Appointment relations
  appointmentsManaged      Appointment[]                    @relation("AppointmentAdmin")
  appointmentNotesCreated  AppointmentNote[]                @relation("NoteCreatedByAdmin")
  appointmentReschedules   AppointmentRescheduleHistory[]  @relation("RescheduleChangedByAdmin")
  appointmentOutcomes      AppointmentOutcomeHistory[]     @relation("OutcomeChangedByAdmin")
  appointmentCancellations AppointmentCancellationHistory[] @relation("CancellationChangedByAdmin")

  // Governance & Wave 6 relations
  adminPermissions     AdminPermission[] @relation("UserPermissions")
  grantedPermissions   AdminPermission[] @relation("GrantedPermissions")
  adminSessions        AdminSession[]
  securityAlerts       SecurityAlert[]
  reviewsReceived      AdminReview[]     @relation("AdminReviewed")
  reviewsGiven         AdminReview[]     @relation("AdminReviewer")

  // Wave 7 Governance fields
  isFounder            Boolean           @default(false)
  isPrimarySA          Boolean           @default(false)
  promotedById         String?
  promotedBy           User?             @relation("UserPromotions", fields: [promotedById], references: [id])
  promotedUsers        User[]            @relation("UserPromotions")
  promotedAt           DateTime?
  governanceLocked     Boolean           @default(false)

  // Wave 7A Hardened Security Fields
  passwordChangedAt     DateTime?
  failedLoginAttempts   Int       @default(0)
  lastFailedLoginAt     DateTime?
  accountLockedUntil    DateTime?
  mustChangePassword    Boolean   @default(false)
  mfaEnabled            Boolean   @default(false)
  mfaSecret             String?
  mfaRecoveryCodes      String[]
  lastLoginAt           DateTime?
  lastLoginIP           String?
  lastLoginDevice       String?
  lastLoginCountry      String?

  passwordHistories     PasswordHistory[]
  passwordResetTokens   PasswordResetToken[]
  otpVerifications      OtpVerification[]
}

model AuthToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  type      String   // "VERIFY_EMAIL", "RESET_PASSWORD"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id             String          @id @default(uuid())
  name           String          // Treated as Title
  description    String          @default("")
  type           String          @default("Apartment") // Apartment, Villa, Penthouse, Duplex, Lot
  category       String          @default("Buy") // Buy, Rent
  price          Float
  bedrooms       Int
  bathrooms      Int             @default(1)
  area           Float           // in sq ft
  areaUnit       String          @default("Sq Ft")
  floor          Int
  availability   String          @default("AVAILABLE") // "AVAILABLE", "SOLD", "RESERVED"
  images         String          @default("") // Comma-separated list for backwards compatibility
  floorPlan      String?         // image URL
  views          Int             @default(0)
  location       String          @default("") // Kept for backwards compatibility
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]
  savedBy        SavedProperty[]

  // New fields for Section 2A
  state          String          @default("")
  city           String          @default("")
  address        String          @default("")
  latitude       Float?
  longitude      Float?
  boundary       String?         // Stringified JSON representing polygon coordinates
  amenities      String[]        // Scalar string list for PostgreSQL
  featured       Boolean         @default(false)
  imagesRelation PropertyImage[]
  propertyViews  PropertyView[]

  // Fields for Wave 1
  status         PropertyStatus  @default(DRAFT)
  videoUrl       String?
  brochureUrl    String?
  virtualTourUrl String?
  boundaryZones  Json?
  priceHistories PropertyPriceHistory[]
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  publicId   String   // Cloudinary Public ID
  url        String   // Image URL
  order      Int      @default(0) // Display Order
  isCover    Boolean  @default(false) // Cover Image Flag
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model SavedProperty {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Appointment {
  id              String   @id @default(uuid())
  userId          String
  propertyId      String
  name            String
  email           String
  phone           String
  date            String // "YYYY-MM-DD"
  time            String // "HH:MM"
  message         String?
  specialRequests String?
  status          String   @default("PENDING") // "PENDING", "APPROVED", "CONFIRMED", "COMPLETED", "CANCELLED", "RESCHEDULED"
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Wave 5 relations & time ranges
  adminId         String?
  admin           User?                            @relation("AppointmentAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  leadId          String?
  lead            Lead?                            @relation("AppointmentLead", fields: [leadId], references: [id], onDelete: SetNull)
  outcome         AppointmentOutcome?
  startTime       DateTime                         @default(now())
  endTime         DateTime                         @default(now())
  completedAt     DateTime?
  notes           AppointmentNote[]
  rescheduleHistory AppointmentRescheduleHistory[]
  outcomeHistory  AppointmentOutcomeHistory[]
  cancellationHistory AppointmentCancellationHistory?

  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([adminId])
  @@index([propertyId])
  @@index([leadId])
}

model AvailableSlot {
  id        String   @id @default(uuid())
  date      String   // YYYY-MM-DD
  time      String   // HH:MM / AM-PM
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Lead {
  id                String                  @id @default(uuid())
  name              String
  email             String
  phone             String?
  message           String
  status            LeadStatus              @default(NEW)
  priority          LeadPriority            @default(MEDIUM)
  source            LeadSource              @default(WEBSITE)
  tags              String[]
  assignedToId      String?
  assignedTo        User?                   @relation("LeadAssignedAdmin", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  notes             LeadNote[]
  comments          LeadComment[]
  followUps         FollowUp[]
  communications    CommunicationLog[]
  assignmentHistory LeadAssignmentHistory[]
  statusHistory     LeadStatusHistory[]
  appointments      Appointment[]           @relation("AppointmentLead")
}

model LeadNote {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content     String
  createdById String?
  createdBy   User?    @relation("NoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  history     Json?    // Array of { content: string, updatedAt: string }
}

model LeadComment {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content     String
  createdById String?
  createdBy   User?    @relation("CommentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeadAssignmentHistory {
  id           String   @id @default(uuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?    @relation("AssignmentHistoryTarget", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedById String?
  assignedBy   User?    @relation("AssignmentHistoryActor", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime @default(now())
}

model LeadStatusHistory {
  id          String     @id @default(uuid())
  leadId      String
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus  LeadStatus
  toStatus    LeadStatus
  changedById String?
  changedBy   User?      @relation("StatusHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime   @default(now())
}

model FollowUp {
  id           String    @id @default(uuid())
  title        String
  description  String?
  dueDate      DateTime
  completed    Boolean   @default(false)
  completedAt  DateTime?
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?     @relation("FollowUpAssignedAdmin", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?     @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  history      Json?     // Array of updates
}

model CommunicationLog {
  id          String            @id @default(uuid())
  leadId      String
  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        CommunicationType
  content     String
  createdById String?
  createdBy   User?             @relation("CommunicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
}

model ActivityLog {
  id            String         @id @default(uuid())
  actorId       String?
  actor         User?          @relation("ActorRelation", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId  String?
  targetUser    User?          @relation("TargetRelation", fields: [targetUserId], references: [id], onDelete: SetNull)
  action        ActivityAction
  description   String
  details       Json?
  createdAt     DateTime       @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  title       String
  message     String
  type        NotificationType
  read        Boolean          @default(false)
  link        String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model PropertyView {
  id          String   @id @default(uuid())
  userId      String?
  propertyId  String
  viewedAt    DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
  @@index([viewedAt])
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PropertyPriceHistory {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  oldPrice    Float
  newPrice    Float
  changedById String?
  changedBy   User?    @relation("PriceChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([propertyId])
  @@index([createdAt])
}

model RoleHistory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation("RoleHistoryTarget", fields: [userId], references: [id], onDelete: Cascade)
  changedById  String?
  changedBy    User?    @relation("RoleHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)
  previousRole String
  newRole      String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model UserStatusHistory {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation("StatusHistoryTarget", fields: [userId], references: [id], onDelete: Cascade)
  changedById    String?
  changedBy      User?      @relation("StatusHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)
  previousStatus UserStatus
  newStatus      UserStatus
  reason         String?
  createdAt      DateTime   @default(now())

  @@index([userId])
  @@index([createdAt])
}

model UserProfileHistory {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("ProfileHistoryTarget", fields: [userId], references: [id], onDelete: Cascade)
  changedById String?
  changedBy   User?    @relation("ProfileHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)
  fieldName   String
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum AppointmentOutcome {
  INTERESTED
  VERY_INTERESTED
  FOLLOW_UP_REQUIRED
  NEGOTIATION_STARTED
  NOT_INTERESTED
  NO_SHOW
  SALE_COMPLETED
}

model AppointmentNote {
  id             String      @id @default(uuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?       @relation("NoteCreatedByAdmin", fields: [createdById], references: [id], onDelete: SetNull)
  content        String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([appointmentId])
}

model AppointmentRescheduleHistory {
  id             String      @id @default(uuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  previousDate   String
  newDate        String
  reason         String?
  changedById    String?
  changedBy      User?       @relation("RescheduleChangedByAdmin", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())

  @@index([appointmentId])
  @@index([createdAt])
}

model AppointmentOutcomeHistory {
  id                String              @id @default(uuid())
  appointmentId     String
  appointment       Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  previousOutcome   AppointmentOutcome?
  newOutcome        AppointmentOutcome
  changedById       String?
  changedBy         User?               @relation("OutcomeChangedByAdmin", fields: [changedById], references: [id], onDelete: SetNull)
  notes             String?
  outcomeRecordedAt DateTime            @default(now())
  createdAt         DateTime            @default(now())

  @@index([appointmentId])
  @@index([createdAt])
}

model AppointmentCancellationHistory {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  cancelledById String?
  cancelledBy   User?       @relation("CancellationChangedByAdmin", fields: [cancelledById], references: [id], onDelete: SetNull)
  reason        String?
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum LegacyPermission {
  MANAGE_PROPERTIES
  MANAGE_LEADS
  MANAGE_APPOINTMENTS
  MANAGE_USERS
  VIEW_ANALYTICS
  EXPORT_DATA
  MANAGE_CONTENT
  MANAGE_SETTINGS
  MANAGE_ADMINS
  VIEW_SECURITY
  VIEW_AUDITS
  VIEW_FINANCIALS
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model AdminPermission {
  id          String           @id @default(uuid())
  userId      String
  permission  LegacyPermission
  grantedById String?
  createdAt   DateTime   @default(now())

  user        User       @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?      @relation("GrantedPermissions", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, permission])
  @@index([userId])
}

model AdminSession {
  id              String    @id @default(uuid())
  userId          String
  ipAddress       String?
  browser         String?
  device          String?
  operatingSystem String?
  country         String?
  city            String?
  loginAt         DateTime  @default(now())
  lastActivityAt  DateTime  @default(now())
  logoutAt        DateTime?
  isActive        Boolean   @default(true)

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model SecurityAlert {
  id          String        @id @default(uuid())
  adminId     String?
  admin       User?         @relation(fields: [adminId], references: [id], onDelete: SetNull)
  type        String
  severity    AlertSeverity
  description String
  details     Json?
  resolved    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([adminId])
  @@index([resolved])
}

model AdminReview {
  id           String      @id @default(uuid())
  adminId      String
  reviewedById String?
  rating       Int
  notes        String?
  createdAt    DateTime    @default(now())

  admin        User        @relation("AdminReviewed", fields: [adminId], references: [id], onDelete: Cascade)
  reviewedBy   User?       @relation("AdminReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([adminId])
}

model GovernanceHistory {
  id           String        @id @default(uuid())
  targetUserId String
  actorId      String
  previousRole UserRole?
  newRole      UserRole
  reason       String?
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([targetUserId])
  @@index([actorId])
  @@index([createdAt])
}

model SystemSetting {
  key   String @id
  value String
}

model PasswordHistory {
  id        String   @id @default(uuid())
  userId    String
  hash      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String?
  userAgent String?
  browser   String?
  device    String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model OtpVerification {
  id          String    @id @default(uuid())
  userId      String?
  phoneNumber String
  otpHash     String
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber])
  @@index([createdAt])
}
