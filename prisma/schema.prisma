datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

model User {
  id              String          @id @default(uuid())
  name            String?
  email           String          @unique
  phone           String?
  password        String?
  role            String          @default("USER") // "USER", "ADMIN"
  emailVerified   DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  appointments    Appointment[]
  savedProperties SavedProperty[]
  authTokens      AuthToken[]
}

model AuthToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  type      String   // "VERIFY_EMAIL", "RESET_PASSWORD"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Property {
  id             String          @id @default(uuid())
  name           String          // Treated as Title
  description    String          @default("")
  type           String          @default("Apartment") // Apartment, Villa, Penthouse, Duplex, Lot
  category       String          @default("Buy") // Buy, Rent
  price          Float
  bedrooms       Int
  bathrooms      Int             @default(1)
  area           Float           // in sq ft
  floor          Int
  availability   String          @default("AVAILABLE") // "AVAILABLE", "SOLD", "RESERVED"
  images         String          @default("") // Comma-separated list for backwards compatibility
  floorPlan      String?         // image URL
  views          Int             @default(0)
  location       String          @default("") // Kept for backwards compatibility
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]
  savedBy        SavedProperty[]

  // New fields for Section 2A
  state          String          @default("")
  city           String          @default("")
  address        String          @default("")
  latitude       Float?
  longitude      Float?
  boundary       String?         // Stringified JSON representing polygon coordinates
  amenities      String[]        // Scalar string list for PostgreSQL
  featured       Boolean         @default(false)
  imagesRelation PropertyImage[]
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  publicId   String   // Cloudinary Public ID
  url        String   // Image URL
  order      Int      @default(0) // Display Order
  isCover    Boolean  @default(false) // Cover Image Flag
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model SavedProperty {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Appointment {
  id              String   @id @default(uuid())
  userId          String
  propertyId      String
  name            String
  email           String
  phone           String
  date            String // "YYYY-MM-DD"
  time            String // "HH:MM"
  message         String?
  specialRequests String?
  status          String   @default("PENDING") // "PENDING", "CONFIRMED", "COMPLETED", "CANCELLED", "RESCHEDULED"
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model AvailableSlot {
  id        String   @id @default(uuid())
  date      String   // YYYY-MM-DD
  time      String   // HH:MM / AM-PM
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("PENDING") // "PENDING", "CONTACTED"
  createdAt DateTime @default(now())
}
